params {
    max_memory                 = 375.GB
    max_cpus                   = 32
    max_time                   = 14.d
}
process {
    executor       = 'slurm'
    queue          = 'sahmri_prod_hpc,sahmri_cancer_hpc'
    maxRetries     = 2
}
executor {
    queueSize       = 50
    submitRateLimit = '10 sec'
}
singularity {
    enabled      = true
    autoMounts   = true
    beforeScript = 'export PATH=/apps/opt/singularity/latest/bin:${PATH}'
    cacheDir     = '/cancer/storage/shared/simg'
}
